<Window x:Class="MiruPlay.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MiruPlay.Windows.Controls"
        xmlns:services="clr-namespace:MiruPlay.Windows.Services"
        mc:Ignorable="d"
        Title="MiruPlay"
        Width="1200"
        Height="780"
        MinWidth="720"
        MinHeight="540"
        Icon="Assets/MiruPlay.ico"
        Background="{StaticResource DarkBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource DarkBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                    <Image Source="Assets/MiruPlay.ico" Width="34" Height="34" />
                    <TextBlock Text="MiruPlay" Margin="10,0,0,0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="LibraryNavButton" Style="{StaticResource NavButton}" Tag="Selected" AutomationProperties.Name="{services:Loc nav.library}" Click="LibraryNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="17" Width="28" />
                            <TextBlock Text="{services:Loc nav.library}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="{services:Loc wpf.main.settings}" Click="SettingsNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="17" Width="28" />
                            <TextBlock Text="{services:Loc wpf.main.settings}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MusicNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="{services:Loc wpf.main.musicLib}" Click="OpenMusicLibrary_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♪" FontSize="17" Width="28" />
                            <TextBlock Text="{services:Loc wpf.main.music}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{services:Loc wpf.main.appMode}" Style="{StaticResource SecondaryText}" Margin="12,22,0,7" />
                    <ComboBox x:Name="AppModeSelector" SelectionChanged="AppMode_SelectionChanged" AutomationProperties.Name="{services:Loc wpf.main.appMode}">
                        <ComboBoxItem Tag="anime"><TextBlock Text="{services:Loc sources.anime}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        <ComboBoxItem Tag="drama"><TextBlock Text="{services:Loc sources.drama}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="WINDOWS" Style="{StaticResource SecondaryText}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="LibrarySchemaText" Text="{services:Loc wpf.main.notLoaded}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="LibraryPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="30,24,30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{services:Loc nav.library}" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="LibrarySummaryText" Text="{services:Loc wpf.main.openHint}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Padding="38,8,12,8" TextChanged="SearchBox_TextChanged" ToolTip="{services:Loc wpf.main.searchTip}" />
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Button Grid.Column="3" Click="OpenLibrary_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Margin="0,0,8,0" />
                            <TextBlock Text="{services:Loc wpf.main.openLib}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DetailColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="30,0,20,24">
                        <StackPanel>
                        <StackPanel x:Name="ContinueSection" Visibility="Collapsed" Margin="0,0,0,24">
                            <TextBlock Text="{services:Loc lib.continue}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="ContinueList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="270" Height="88" Margin="0,0,12,0"
                                                Style="{StaticResource MediaCardButton}"
                                                Tag="{Binding Episode}"
                                                AutomationProperties.Name="{Binding AccessibleName}"
                                                Click="PlayEpisode_Click">
                                            <Grid Margin="14,11">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding SeriesTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="{Binding Episode.DisplayNumber}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                                <ProgressBar Grid.Row="2" Height="4" Maximum="100" Value="{Binding Episode.ProgressPercent, Mode=OneWay}" Foreground="{StaticResource AnimeRed}" Background="{StaticResource AccentBlue}" VerticalAlignment="Bottom" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel x:Name="RecentSection" Visibility="Collapsed" Margin="0,0,0,24">
                            <TextBlock Text="{services:Loc wpf.main.recent}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="220" Height="70" Margin="0,0,12,0" Style="{StaticResource MediaCardButton}" Tag="{Binding}" Click="SeriesCard_Click" AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Margin="12,10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding CompletionText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" /></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel x:Name="FeaturedSection" Visibility="Collapsed" Margin="0,0,0,24">
                            <TextBlock Text="{services:Loc wpf.main.featured}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="FeaturedList">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="220" Height="70" Margin="0,0,12,0" Style="{StaticResource MediaCardButton}" Tag="{Binding}" Click="SeriesCard_Click" AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Margin="12,10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding MetadataLine}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl x:Name="GenreGroupList" Margin="0,0,0,24">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding Series}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="174" Height="54" Margin="0,0,12,10" Style="{StaticResource MediaCardButton}" Tag="{Binding}" Click="SeriesCard_Click" AutomationProperties.Name="{Binding Title}">
                                                        <StackPanel Margin="10,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding CompletionText}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AllSeriesTitle" Text="{services:Loc wpf.main.allWorks}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" Visibility="Collapsed" />
                        <ItemsControl x:Name="SeriesList" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="174" Height="292" Margin="0,0,16,18"
                                            Style="{StaticResource MediaCardButton}"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="{Binding Title}"
                                            Click="SeriesCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="230" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Background="{StaticResource AccentBlue}">
                                                <TextBlock Text="{Binding Initial}" FontSize="54" FontWeight="Bold" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding PosterPath, Converter={StaticResource PosterImageConverter}}" Stretch="UniformToFill" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="10,8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                <TextBlock Text="{Binding MetadataLine}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="LoadMoreButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="{services:Loc wpf.main.loadMore}"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,18"
                                Visibility="Collapsed"
                                Click="LoadMore_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="EmptyState" Visibility="Visible" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="44" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateTitle" Text="{services:Loc wpf.main.noLibrary}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock x:Name="EmptyStateDescription" Text="{services:Loc wpf.main.noLibraryHint}" Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" x:Name="DetailPanel" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1,0,0,0" Padding="26,24" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{services:Loc wpf.main.detail}" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="{services:Loc wpf.main.closeDetail}" Click="CloseDetail_Click" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                                <StackPanel>
                                    <Grid Height="230" Background="{StaticResource AccentBlue}">
                                        <TextBlock Text="{Binding Initial}" FontSize="58" FontWeight="Bold" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding PosterPath, Converter={StaticResource PosterImageConverter}}" Stretch="UniformToFill" />
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Margin="0,18,0,0" />
                                    <TextBlock Text="{Binding OriginalTitle}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding MetadataLine}" Foreground="{StaticResource AnimeRed}" Margin="0,9,0,0" />
                                    <ItemsControl ItemsSource="{Binding ExternalLinks}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="{Binding DisplayLabel}"
                                                        Tag="{Binding Link}"
                                                        Margin="0,0,8,0"
                                                        Click="OpenMetadataLink_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0" />
                                    <TextBlock Text="{services:Loc wpf.detail.episodes}" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
                                    <ItemsControl ItemsSource="{Binding Seasons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,14">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource AnimeRed}" Margin="0,0,0,6" />
                                                    <ItemsControl ItemsSource="{Binding Groups}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,8">
                                                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryText}" FontSize="11" Visibility="{Binding HasVersions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <ItemsControl ItemsSource="{Binding Versions}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,0,0,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding DisplayNumber}" FontWeight="SemiBold" />
                                                                                        <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                                                                                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource SecondaryText}" FontSize="11" />
                                                                                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource AnimeRed}" FontSize="11" />
                                                                                        <ProgressBar Height="3" Margin="0,5,12,0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{StaticResource AnimeRed}" Background="{StaticResource AccentBlue}" />
                                                                                    </StackPanel>
                                                                                    <Button Grid.Column="1" Tag="{Binding}" AutomationProperties.Name="{services:Loc Key=wpf.play.playFor, Arg={Binding DisplayTitle}}" Click="PlayEpisode_Click" ToolTip="{services:Loc wpf.play.play}" Padding="12,8">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;" Margin="0,0,6,0" />
                                                                                            <TextBlock Text="{Binding PlayActionLabel}" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Visibility="{Binding HasExtras, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{services:Loc wpf.detail.extras}" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />
                                        <ItemsControl ItemsSource="{Binding Extras}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding DurationText}" Style="{StaticResource SecondaryText}" FontSize="11" /></StackPanel>
                                                        <Button Grid.Column="1" Tag="{Binding}" Click="PlayExtra_Click" ToolTip="{services:Loc wpf.main.playExtra}" AutomationProperties.Name="{services:Loc wpf.main.playExtra}" Padding="12,8"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;" /></Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,1,0,0" Padding="32,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="{services:Loc wpf.main.ready}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="{services:Loc wpf.main.settings}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{services:Loc wpf.main.settingsSub}" Style="{StaticResource SecondaryText}" Margin="0,4,0,30" />

                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{services:Loc wpf.main.appMode}" FontWeight="SemiBold" />
                            <TextBlock Text="{services:Loc wpf.main.appModeHint}" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <ComboBox x:Name="SettingsAppMode" Grid.Column="1" SelectionChanged="AppMode_SelectionChanged" AutomationProperties.Name="{services:Loc wpf.main.appModeName}">
                            <ComboBoxItem Tag="anime"><TextBlock Text="{services:Loc sources.anime}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="drama"><TextBlock Text="{services:Loc sources.drama}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="WebUI" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <Grid Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WebControl" FontWeight="SemiBold" />
                            <TextBlock Text="{services:Loc wpf.main.lanNote}" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <CheckBox x:Name="WebControlEnabledCheckBox" Grid.Column="1" Content="{services:Loc wpf.main.enable}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Click="WebControlEnabled_Click" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{services:Loc access.url}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBox x:Name="WebControlUrlValue" Grid.Column="1" IsReadOnly="True" />
                    </Grid>
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{services:Loc access.token}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBox x:Name="WebControlTokenValue" Grid.Column="1" IsReadOnly="True" />
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.copyUrl}" Click="CopyWebControlUrl_Click" />
                        <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.rotateToken}" Click="RotateWebControlToken_Click" />
                    </Grid>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="{services:Loc wpf.main.onlineMeta}" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <TextBlock Text="{services:Loc wpf.dsp.heading}" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <Grid Margin="0,14,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="AudioDspSummaryText" Text="{services:Loc wpf.main.dspOff}" FontWeight="SemiBold" />
                            <TextBlock Text="{services:Loc wpf.main.dspHint}" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="AudioDspEnabledCheckBox" IsHitTestVisible="False" Focusable="False" Content="{services:Loc wpf.main.enable}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" AutomationProperties.Name="{services:Loc wpf.main.dspState}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.editDsp}" Padding="14,7" Margin="14,0,0,0" Click="OpenAudioDsp_Click" AutomationProperties.Name="{services:Loc wpf.main.editDspName}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Bangumi Access Token" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="BangumiTokenBox" Padding="10,8" AutomationProperties.Name="Bangumi Access Token" />
                        <Button Grid.Column="1" Content="{services:Loc wpf.main.saveBangumi}" Click="SaveBangumiToken_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.clearBangumi}" Click="ClearBangumiToken_Click" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="BangumiTokenStatusText" Text="{services:Loc wpf.main.noBangumi}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Text="TMDB Read Access Token" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Grid Margin="0,8,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TmdbTokenBox" Padding="10,8" AutomationProperties.Name="TMDB Read Access Token" />
                        <Button Grid.Column="1" Content="{services:Loc wpf.main.save}" Click="SaveTmdbToken_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.clear}" Click="ClearTmdbToken_Click" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="TmdbTokenStatusText" Text="{services:Loc wpf.main.noTmdb}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="CloudDrive / RSS" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="{services:Loc wpf.main.cdEndpoint}" VerticalAlignment="Center" />
                        <TextBox x:Name="CloudDriveEndpointBox" Grid.Column="1" AutomationProperties.Name="{services:Loc wpf.main.cdEndpoint}" />
                        <TextBlock Grid.Row="1" Text="{services:Loc sources.username}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox x:Name="CloudDriveUsernameBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{services:Loc wpf.main.cdUser}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="{services:Loc wpf.main.cdInbox}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox x:Name="CloudDriveInboxBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="{services:Loc wpf.main.cdInboxName}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Text="{services:Loc wpf.main.cdLibrary}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox x:Name="CloudDriveLibraryBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="{services:Loc wpf.main.cdLibName}" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Text="{services:Loc wpf.main.cdMode}" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox x:Name="CloudDriveLibraryModeBox" Width="210" AutomationProperties.Name="{services:Loc wpf.main.cdModeName}"><ComboBoxItem Tag="ORGANIZED_LIBRARY"><TextBlock Text="{services:Loc wpf.main.cdOrganized}" Style="{StaticResource ComboItemText}" /></ComboBoxItem><ComboBoxItem Tag="SINGLE_DIRECTORY"><TextBlock Text="{services:Loc wpf.main.cdSingle}" Style="{StaticResource ComboItemText}" /></ComboBoxItem></ComboBox>
                            <TextBox x:Name="CloudDriveIntervalBox" Width="80" Margin="8,0,0,0" AutomationProperties.Name="{services:Loc wpf.main.cdInterval}" />
                            <CheckBox x:Name="CloudDriveEnabledCheckBox" Content="{services:Loc wpf.main.enable}" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <Button Content="{services:Loc cloud.saveConfig}" Click="SaveCloudDriveConfig_Click" Margin="12,0,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{services:Loc cloud.run}" Click="RunCloudDriveNow_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="CloudDrivePasswordBox" AutomationProperties.Name="{services:Loc wpf.main.cdPassword}" />
                        <PasswordBox x:Name="CloudDriveTokenBox" Grid.Column="1" AutomationProperties.Name="CloudDrive2 API Token" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="{services:Loc wpf.main.login}" Click="LoginCloudDrive_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="3" Content="{services:Loc wpf.main.verifyToken}" Click="VerifyCloudDriveToken_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.clearCreds}" Click="ClearCloudDriveCredentials_Click" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="CloudDriveStatusText" Text="{services:Loc wpf.main.cdNotConfigured}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Text="{services:Loc cloud.rssTitle}" FontWeight="SemiBold" Margin="0,14,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RssNameBox" AutomationProperties.Name="{services:Loc wpf.main.rssName}" ToolTip="{services:Loc wpf.main.rssName}" />
                        <TextBox x:Name="RssUrlBox" Grid.Column="1" AutomationProperties.Name="{services:Loc wpf.main.rssAddress}" ToolTip="{services:Loc wpf.main.rssAddress}" Margin="8,0,0,0" />
                        <TextBox x:Name="RssFilterBox" Grid.Column="2" AutomationProperties.Name="{services:Loc wpf.main.rssFilterName}" ToolTip="{services:Loc wpf.main.rssFilter}" Margin="8,0,0,0" />
                        <Button Grid.Column="3" Content="{services:Loc wpf.main.saveRss}" Click="SaveRssSubscription_Click" Margin="8,0,0,0" />
                    </Grid>
                    <CheckBox x:Name="RssEnabledCheckBox" Content="{services:Loc wpf.main.enableSub}" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,10" />
                    <TextBlock x:Name="RssStatusText" Text="{services:Loc wpf.main.noRss}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="RssSubscriptionList" Margin="0,0,0,28">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="{StaticResource DarkSurface}" Margin="0,0,0,1" MinHeight="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="14,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" MaxWidth="650" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="{services:Loc wpf.main.previewRss}" ToolTip="{services:Loc wpf.main.pullPreview}" Click="PreviewRssSubscription_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71C;" /></Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="{services:Loc wpf.main.editRss}" ToolTip="{services:Loc sources.edit}" Click="EditRssSubscription_Click" Margin="6,0,0,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" /></Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="{services:Loc wpf.main.deleteRss}" ToolTip="{services:Loc sources.delete}" Click="DeleteRssSubscription_Click" Margin="6,0,0,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" /></Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="{services:Loc wpf.main.scanTitle}" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <Grid Margin="0,14,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox x:Name="AutoScanEnabledCheckBox"
                                      Content="{services:Loc wpf.main.autoScanSrc}"
                                      Foreground="{StaticResource TextPrimary}"
                                      AutomationProperties.Name="{services:Loc wpf.main.autoScanSrc}"
                                      Click="AutoScanEnabled_Click" />
                            <TextBlock x:Name="AutoScanStatusText"
                                       Text="{services:Loc wpf.main.autoScanOff}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="24,5,18,0" />
                        </StackPanel>
                        <ComboBox x:Name="AutoScanIntervalBox"
                                  Grid.Column="1"
                                  AutomationProperties.Name="{services:Loc wpf.main.scanInterval}"
                                  SelectionChanged="AutoScanInterval_SelectionChanged">
                            <ComboBoxItem Tag="1"><TextBlock Text="{services:Loc wpf.main.every1h}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="6"><TextBlock Text="{services:Loc wpf.main.every6h}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="12"><TextBlock Text="{services:Loc wpf.main.every12h}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="24"><TextBlock Text="{services:Loc wpf.main.every24h}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <CheckBox x:Name="MergeSameAnimeCheckBox" Content="{services:Loc playback.merge}"
                                      Foreground="{StaticResource TextPrimary}"
                                      AutomationProperties.Name="{services:Loc playback.merge}" Click="LibraryOrganization_Changed" />
                            <TextBlock Text="{services:Loc wpf.main.mergeHint}"
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,5,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="PosterArrangementBox" Grid.Column="1"
                                  AutomationProperties.Name="{services:Loc playback.poster}" SelectionChanged="LibraryOrganization_Changed">
                            <ComboBoxItem Tag="TITLE"><TextBlock Text="{services:Loc playback.byTitle}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="RELEASE_SEASON"><TextBlock Text="{services:Loc playback.bySeason}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="{services:Loc playback.version}" FontWeight="SemiBold" />
                            <TextBlock Text="{services:Loc wpf.main.versionHint}"
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="EpisodeVersionSelectionPolicyBox" Grid.Column="1"
                                  AutomationProperties.Name="{services:Loc wpf.main.versionName}"
                                  SelectionChanged="EpisodeVersionSelectionPolicy_Changed">
                            <ComboBoxItem Tag="auto_nearest"><TextBlock Text="{services:Loc playback.autoNearest}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="manual"><TextBlock Text="{services:Loc playback.manual}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{services:Loc nav.sources}" Style="{StaticResource SectionTitle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.addLocal}" Click="OpenLibrary_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.addDav}" Click="AddWebDavSource_Click" Margin="8,0,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.addRss}" Click="AddRssMediaSource_Click" Margin="8,0,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.main.addSmb}" Click="AddSmbSource_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,14,0,12">
                        <TextBlock Text="{services:Loc wpf.main.currentLib}" FontWeight="SemiBold" />
                        <TextBlock x:Name="LibraryRootValue" Text="{services:Loc wpf.main.notSet}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl x:Name="SourceList" Margin="0,0,0,28">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,1" Background="{StaticResource DarkSurface}" MinHeight="66">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="14,10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TypeLabel, StringFormat=  ·  {0}}" Foreground="{StaticResource AnimeRed}" />
                                            <TextBlock Text="{Binding StatusText, StringFormat=  ·  {0}}" Style="{StaticResource SecondaryText}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" MaxWidth="590" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="{services:Loc wpf.main.openSrc}" ToolTip="{services:Loc wpf.main.open}" Click="ActivateSource_Click">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="{services:Loc wpf.main.scanSrc}" ToolTip="{services:Loc sources.scan}" Click="ScanSource_Click" Margin="6,0,0,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="{services:Loc wpf.main.editSrc}" ToolTip="{services:Loc sources.edit}" Click="EditSource_Click" Margin="6,0,0,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="{services:Loc wpf.main.deleteSrc}" ToolTip="{services:Loc sources.delete}" Click="RemoveSource_Click" Margin="6,0,0,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{services:Loc wpf.main.afterPlay}" FontWeight="SemiBold" />
                            <TextBlock Text="{services:Loc wpf.main.afterPlayHint}" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <ComboBox x:Name="PlaybackEndAction" Grid.Column="1" SelectionChanged="PlaybackEndAction_SelectionChanged">
                            <ComboBoxItem Tag="return_to_detail"><TextBlock Text="{services:Loc wpf.play.back}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="play_next_episode"><TextBlock Text="{services:Loc wpf.main.playNext}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{services:Loc wpf.main.subLang}" FontWeight="SemiBold" />
                            <TextBlock Text="{services:Loc wpf.main.subHint}" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <ComboBox x:Name="SubtitlePreference" Grid.Column="1" SelectionChanged="SubtitlePreference_SelectionChanged">
                            <ComboBoxItem Tag="auto"><TextBlock Text="{services:Loc sub.auto}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh_hans"><TextBlock Text="{services:Loc sub.hans}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh_hant"><TextBlock Text="{services:Loc sub.hant}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh"><TextBlock Text="{services:Loc sub.zh}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="en"><TextBlock Text="{services:Loc sub.en}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="ja"><TextBlock Text="{services:Loc sub.ja}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{services:Loc playback.appLang}" FontWeight="SemiBold" />
                            <TextBlock Text="{services:Loc wpf.main.langHint}" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <ComboBox x:Name="AppLanguageBox" Grid.Column="1" SelectionChanged="AppLanguage_SelectionChanged">
                            <ComboBoxItem Tag="system"><TextBlock Text="{services:Loc locale.system}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh-CN"><TextBlock Text="{services:Loc locale.zhCN}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh-TW"><TextBlock Text="{services:Loc locale.zhTW}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh-HK"><TextBlock Text="{services:Loc locale.zhHK}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="en-US"><TextBlock Text="English (US)" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="en-GB"><TextBlock Text="English (UK)" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="{services:Loc wpf.main.about}" Style="{StaticResource SectionTitle}" Margin="0,28,0,12" />
                    <TextBlock Text="MiruPlay Windows" FontWeight="SemiBold" />
                    <TextBlock Text="{services:Loc wpf.main.aboutText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#D9202020" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar x:Name="BusyProgressBar" Width="260" Height="4" IsIndeterminate="True" Foreground="{StaticResource AnimeRed}" />
                    <TextBlock x:Name="BusyOperationText" Text="{services:Loc wpf.main.loadingLib}" Margin="0,16,0,0" FontSize="16" />
                    <TextBlock x:Name="BusyProgressText" Text="" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                    <Button x:Name="CancelScanButton" Content="{services:Loc wpf.main.cancelScan}" Visibility="Collapsed" Margin="0,12,0,0" Click="CancelScan_Click" />
                </StackPanel>
            </Border>

            <controls:SeriesDetailPage x:Name="SeriesDetailPageView" Visibility="Collapsed" />
            <controls:PlaybackPage x:Name="PlaybackPageView" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
