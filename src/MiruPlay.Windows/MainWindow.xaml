<Window x:Class="MiruPlay.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MiruPlay"
        Width="1200"
        Height="780"
        MinWidth="720"
        MinHeight="540"
        Background="{StaticResource DarkBackground}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource DarkBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{StaticResource AnimeRed}" CornerRadius="6">
                        <TextBlock Text="M" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MiruPlay" Margin="12,0,0,0" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="LibraryNavButton" Style="{StaticResource NavButton}" Tag="Selected" AutomationProperties.Name="媒体库" Click="LibraryNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="17" Width="28" />
                            <TextBlock Text="媒体库" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="设置" Click="SettingsNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="17" Width="28" />
                            <TextBlock Text="设置" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="应用模式" Style="{StaticResource SecondaryText}" Margin="12,22,0,7" />
                    <ComboBox x:Name="AppModeSelector" SelectionChanged="AppMode_SelectionChanged" AutomationProperties.Name="应用模式">
                        <ComboBoxItem Tag="anime"><TextBlock Text="动漫" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        <ComboBoxItem Tag="drama"><TextBlock Text="电视剧" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="WINDOWS" Style="{StaticResource SecondaryText}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="LibrarySchemaText" Text="尚未载入媒体库" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="LibraryPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="32,26,32,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="媒体库" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="LibrarySummaryText" Text="打开包含 library.db 的媒体目录" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Padding="38,8,12,8" TextChanged="SearchBox_TextChanged" ToolTip="搜索标题、原名或类型" />
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Button Grid.Column="3" Click="OpenLibrary_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Margin="0,0,8,0" />
                            <TextBlock Text="打开媒体库" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DetailColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="32,0,20,24">
                        <StackPanel>
                        <StackPanel x:Name="ContinueSection" Visibility="Collapsed" Margin="0,0,0,24">
                            <TextBlock Text="继续观看" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="ContinueList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="270" Height="88" Margin="0,0,12,0"
                                                Style="{StaticResource MediaCardButton}"
                                                Tag="{Binding Episode}"
                                                AutomationProperties.Name="{Binding AccessibleName}"
                                                Click="PlayEpisode_Click">
                                            <Grid Margin="14,11">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding SeriesTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="{Binding Episode.DisplayNumber}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                                <ProgressBar Grid.Row="2" Height="4" Maximum="100" Value="{Binding Episode.ProgressPercent, Mode=OneWay}" Foreground="{StaticResource AnimeRed}" Background="{StaticResource AccentBlue}" VerticalAlignment="Bottom" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock x:Name="AllSeriesTitle" Text="全部作品" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" Visibility="Collapsed" />
                        <ItemsControl x:Name="SeriesList" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="174" Height="292" Margin="0,0,16,18"
                                            Style="{StaticResource MediaCardButton}"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="{Binding Title}"
                                            Click="SeriesCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="230" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Background="{StaticResource AccentBlue}">
                                                <TextBlock Text="{Binding Initial}" FontSize="54" FontWeight="Bold" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding PosterPath, Converter={StaticResource PosterImageConverter}}" Stretch="UniformToFill" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="10,8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                <TextBlock Text="{Binding MetadataLine}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="LoadMoreButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="加载更多"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,18"
                                Visibility="Collapsed"
                                Click="LoadMore_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="EmptyState" Visibility="Visible" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="44" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateTitle" Text="还没有媒体库" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock x:Name="EmptyStateDescription" Text="选择一个由 anime-organizer 生成、根目录包含 library.db 的媒体目录。" Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" x:Name="DetailPanel" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1,0,0,0" Padding="26,24" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="详情" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="关闭详情" Click="CloseDetail_Click" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                                <StackPanel>
                                    <Grid Height="230" Background="{StaticResource AccentBlue}">
                                        <TextBlock Text="{Binding Initial}" FontSize="58" FontWeight="Bold" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding PosterPath, Converter={StaticResource PosterImageConverter}}" Stretch="UniformToFill" />
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Margin="0,18,0,0" />
                                    <TextBlock Text="{Binding OriginalTitle}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding MetadataLine}" Foreground="{StaticResource AnimeRed}" Margin="0,9,0,0" />
                                    <ItemsControl ItemsSource="{Binding ExternalLinks}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="{Binding DisplayLabel}"
                                                        Tag="{Binding Link}"
                                                        Margin="0,0,8,0"
                                                        Click="OpenMetadataLink_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0" />
                                    <TextBlock Text="剧集" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
                                    <ItemsControl ItemsSource="{Binding Episodes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayNumber}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                                                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource SecondaryText}" FontSize="11" />
                                                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource AnimeRed}" FontSize="11" />
                                                        <ProgressBar Height="3" Margin="0,5,12,0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{StaticResource AnimeRed}" Background="{StaticResource AccentBlue}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="{Binding}" AutomationProperties.Name="{Binding DisplayTitle, StringFormat=播放 {0}}" Click="PlayEpisode_Click" ToolTip="播放" Padding="12,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE768;" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding PlayActionLabel}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,1,0,0" Padding="32,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="就绪" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="ActivePlaybackControls" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="字幕" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="ActiveSubtitleTrack" Width="220" DisplayMemberPath="Label" SelectionChanged="ActiveSubtitleTrack_SelectionChanged" AutomationProperties.Name="当前字幕轨道" />
                            <Button Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="播放或暂停" AutomationProperties.Name="播放或暂停" Click="TogglePlayback_Click">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE769;" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="停止" AutomationProperties.Name="停止播放" Click="StopPlayback_Click">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71A;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Windows 客户端的媒体库和播放配置" Style="{StaticResource SecondaryText}" Margin="0,4,0,30" />

                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="应用模式" FontWeight="SemiBold" />
                            <TextBlock Text="媒体库只加载对应模式的媒体源，切换后自动打开可用来源" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <ComboBox x:Name="SettingsAppMode" Grid.Column="1" SelectionChanged="AppMode_SelectionChanged" AutomationProperties.Name="设置应用模式">
                            <ComboBoxItem Tag="anime"><TextBlock Text="动漫" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="drama"><TextBlock Text="电视剧" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="WebUI" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <Grid Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WebControl" FontWeight="SemiBold" />
                            <TextBlock Text="允许局域网设备通过兼容 API 浏览和控制 MiruPlay" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <CheckBox x:Name="WebControlEnabledCheckBox" Grid.Column="1" Content="启用" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Click="WebControlEnabled_Click" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="访问地址" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBox x:Name="WebControlUrlValue" Grid.Column="1" IsReadOnly="True" />
                    </Grid>
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="访问令牌" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBox x:Name="WebControlTokenValue" Grid.Column="1" IsReadOnly="True" />
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="复制地址" Click="CopyWebControlUrl_Click" />
                        <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Content="更换令牌" Click="RotateWebControlToken_Click" />
                    </Grid>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="在线元数据" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <TextBlock Text="Bangumi Access Token" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="BangumiTokenBox" Padding="10,8" AutomationProperties.Name="Bangumi Access Token" />
                        <Button Grid.Column="1" Content="保存 Bangumi" Click="SaveBangumiToken_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="清除 Bangumi" Click="ClearBangumiToken_Click" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="BangumiTokenStatusText" Text="当前未设置 Bangumi Token。" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Text="TMDB Read Access Token" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Grid Margin="0,8,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TmdbTokenBox" Padding="10,8" AutomationProperties.Name="TMDB Read Access Token" />
                        <Button Grid.Column="1" Content="保存" Click="SaveTmdbToken_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="清除" Click="ClearTmdbToken_Click" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="TmdbTokenStatusText" Text="当前未设置 TMDB Token。" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="CloudDrive / RSS" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="CloudDrive2 地址" VerticalAlignment="Center" />
                        <TextBox x:Name="CloudDriveEndpointBox" Grid.Column="1" AutomationProperties.Name="CloudDrive2 地址" />
                        <TextBlock Grid.Row="1" Text="用户名" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox x:Name="CloudDriveUsernameBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="CloudDrive2 用户名" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Text="离线下载目录" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox x:Name="CloudDriveInboxBox" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="CloudDrive2 离线下载目录" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Text="媒体库目录" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox x:Name="CloudDriveLibraryBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="CloudDrive2 媒体库目录" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Text="模式与周期" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox x:Name="CloudDriveLibraryModeBox" Width="210" AutomationProperties.Name="CloudDrive2 媒体库模式"><ComboBoxItem Tag="ORGANIZED_LIBRARY"><TextBlock Text="整理媒体库" Style="{StaticResource ComboItemText}" /></ComboBoxItem><ComboBoxItem Tag="SINGLE_DIRECTORY"><TextBlock Text="单目录" Style="{StaticResource ComboItemText}" /></ComboBoxItem></ComboBox>
                            <TextBox x:Name="CloudDriveIntervalBox" Width="80" Margin="8,0,0,0" AutomationProperties.Name="CloudDrive2 同步周期分钟" />
                            <CheckBox x:Name="CloudDriveEnabledCheckBox" Content="启用" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <Button Content="保存配置" Click="SaveCloudDriveConfig_Click" Margin="12,0,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="立即运行" Click="RunCloudDriveNow_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="CloudDrivePasswordBox" AutomationProperties.Name="CloudDrive2 密码" />
                        <PasswordBox x:Name="CloudDriveTokenBox" Grid.Column="1" AutomationProperties.Name="CloudDrive2 API Token" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="登录" Click="LoginCloudDrive_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="3" Content="验证 Token" Click="VerifyCloudDriveToken_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="清除凭据" Click="ClearCloudDriveCredentials_Click" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="CloudDriveStatusText" Text="CloudDrive2 尚未配置。" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Text="RSS 订阅" FontWeight="SemiBold" Margin="0,14,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RssNameBox" AutomationProperties.Name="RSS 名称" ToolTip="RSS 名称" />
                        <TextBox x:Name="RssUrlBox" Grid.Column="1" AutomationProperties.Name="RSS 地址" ToolTip="RSS 地址" Margin="8,0,0,0" />
                        <TextBox x:Name="RssFilterBox" Grid.Column="2" AutomationProperties.Name="过滤正则" ToolTip="过滤正则（可选）" Margin="8,0,0,0" />
                        <Button Grid.Column="3" Content="保存 RSS" Click="SaveRssSubscription_Click" Margin="8,0,0,0" />
                    </Grid>
                    <CheckBox x:Name="RssEnabledCheckBox" Content="启用订阅" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,10" />
                    <TextBlock x:Name="RssStatusText" Text="尚未配置 RSS 订阅。" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="RssSubscriptionList" Margin="0,0,0,28">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="{StaticResource DarkSurface}" Margin="0,0,0,1" MinHeight="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="14,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" MaxWidth="650" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="预览 RSS" ToolTip="拉取并预览" Click="PreviewRssSubscription_Click"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71C;" /></Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="编辑 RSS" ToolTip="编辑" Click="EditRssSubscription_Click" Margin="6,0,0,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" /></Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="删除 RSS" ToolTip="删除" Click="DeleteRssSubscription_Click" Margin="6,0,0,0"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" /></Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="媒体源" Style="{StaticResource SectionTitle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="添加本地 MLIP" Click="OpenLibrary_Click" />
                            <Button Style="{StaticResource SecondaryButton}" Content="添加 WebDAV" Click="AddWebDavSource_Click" Margin="8,0,0,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="添加 SMB" Click="AddSmbSource_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,14,0,12">
                        <TextBlock Text="当前媒体库" FontWeight="SemiBold" />
                        <TextBlock x:Name="LibraryRootValue" Text="尚未设置" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl x:Name="SourceList" Margin="0,0,0,28">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,1" Background="{StaticResource DarkSurface}" MinHeight="66">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="14,10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TypeLabel, StringFormat=  ·  {0}}" Foreground="{StaticResource AnimeRed}" />
                                            <TextBlock Text="{Binding StatusText, StringFormat=  ·  {0}}" Style="{StaticResource SecondaryText}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" MaxWidth="590" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="打开媒体源" ToolTip="打开" Click="ActivateSource_Click">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="扫描媒体源" ToolTip="扫描" Click="ScanSource_Click" Margin="6,0,0,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="编辑媒体源" ToolTip="编辑" Click="EditSource_Click" Margin="6,0,0,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Tag="{Binding}" AutomationProperties.Name="删除媒体源" ToolTip="删除" Click="RemoveSource_Click" Margin="6,0,0,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="播放器" Style="{StaticResource SectionTitle}" Margin="0,28,0,0" />
                    <Grid Margin="0,14,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="mpv.exe" FontWeight="SemiBold" />
                            <TextBlock x:Name="PlayerPathValue" Text="自动检测；找不到时使用 Windows 默认播放器" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择播放器" Click="ChoosePlayer_Click" />
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="播完后" FontWeight="SemiBold" />
                            <TextBlock Text="决定剧集自然播放完成后的操作" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <ComboBox x:Name="PlaybackEndAction" Grid.Column="1" SelectionChanged="PlaybackEndAction_SelectionChanged">
                            <ComboBoxItem Tag="return_to_detail"><TextBlock Text="返回详情" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="play_next_episode"><TextBlock Text="播放下一集" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="首选字幕语言" FontWeight="SemiBold" />
                            <TextBlock Text="匹配不到时保留播放器默认轨道" Style="{StaticResource SecondaryText}" Margin="0,4,18,0" />
                        </StackPanel>
                        <ComboBox x:Name="SubtitlePreference" Grid.Column="1" SelectionChanged="SubtitlePreference_SelectionChanged">
                            <ComboBoxItem Tag="auto"><TextBlock Text="自动" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh_hans"><TextBlock Text="简体中文" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh_hant"><TextBlock Text="繁体中文" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="zh"><TextBlock Text="任意中文" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="en"><TextBlock Text="英语" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                            <ComboBoxItem Tag="ja"><TextBlock Text="日语" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{StaticResource SubtleBorder}" />
                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="0,28,0,12" />
                    <TextBlock Text="MiruPlay Windows" FontWeight="SemiBold" />
                    <TextBlock Text="原生 Windows 客户端 · 支持 MLIP v1-v3" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#B01A1A2E" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="260" Height="4" IsIndeterminate="True" Foreground="{StaticResource AnimeRed}" />
                    <TextBlock Text="正在读取媒体库…" Margin="0,16,0,0" FontSize="16" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
