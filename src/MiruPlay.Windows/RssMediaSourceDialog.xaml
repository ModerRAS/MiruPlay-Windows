<Window x:Class="MiruPlay.Windows.RssMediaSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RSS 在线媒体源"
        Width="560"
        Height="330"
        Icon="Assets/MiruPlay.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="RSS 在线源" Style="{StaticResource PageTitle}" FontSize="28" />
        <TextBlock Grid.Row="1" Text="名称" Style="{StaticResource SecondaryText}" Margin="0,20,0,6" />
        <TextBox x:Name="SourceNameBox" Grid.Row="2" Text="RSS 在线源" AutomationProperties.Name="RSS 媒体源名称" />
        <TextBlock Grid.Row="3" Text="RSS Feed 地址" Style="{StaticResource SecondaryText}" Margin="0,16,0,6" />
        <TextBox x:Name="LocationBox" Grid.Row="4" Text="https://api.ani.rip/ani-download.xml" AutomationProperties.Name="RSS Feed 地址" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="取消" IsCancel="True" />
            <Button Content="测试并添加" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
