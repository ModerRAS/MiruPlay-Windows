<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tv="clr-namespace:MiruPlay.Windows.Tv">

    <!-- MiruPlay TV (10-foot) palette: existing Windows dark Fluent colours, larger type. -->
    <Color x:Key="TvAccentColor">#FF60CDFF</Color>
    <SolidColorBrush x:Key="TvBackgroundBrush" Color="#FF0B0B0D" />
    <SolidColorBrush x:Key="TvSurfaceBrush" Color="#FF17171B" />
    <SolidColorBrush x:Key="TvSurfaceAltBrush" Color="#FF222228" />
    <SolidColorBrush x:Key="TvSurfaceHoverBrush" Color="#FF2C2C34" />
    <SolidColorBrush x:Key="TvBorderBrush" Color="#FF34343C" />
    <SolidColorBrush x:Key="TvTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TvTextSecondaryBrush" Color="#FFC7C7CF" />
    <SolidColorBrush x:Key="TvTextMutedBrush" Color="#FF9696A2" />
    <SolidColorBrush x:Key="TvAccentBrush" Color="{StaticResource TvAccentColor}" />
    <SolidColorBrush x:Key="TvAccentSoftBrush" Color="#3360CDFF" />
    <SolidColorBrush x:Key="TvDangerBrush" Color="#FFFF8A8A" />
    <SolidColorBrush x:Key="TvScrimBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="TvProgressTrackBrush" Color="#FF3A3A44" />

    <FontFamily x:Key="TvFontFamily">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TvFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TvTextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="TvPageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TvTextBrush}" />
    </Style>

    <Style x:Key="TvRowTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TvTextBrush}" />
    </Style>

    <Style x:Key="TvBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource TvTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TvSecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TvTextMutedBrush}" />
    </Style>

    <Style x:Key="TvHintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource TvTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TvProgressBar" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource TvAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource TvProgressTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Track" Background="Transparent" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left navigation entry: 56px tall, focus expands the rail (host animates width). -->
    <Style x:Key="TvNavButton" TargetType="Button">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="10">
                        <Grid>
                            <Border x:Name="SelectedBar" Width="4" Margin="0,12" CornerRadius="2"
                                    HorizontalAlignment="Left" Background="{StaticResource TvAccentBrush}" Opacity="0" />
                            <ContentPresenter Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Root" Property="Background" Value="#FF1C1C22" />
                            <Setter TargetName="SelectedBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TvSurfaceHoverBrush}" />
                            <Setter TargetName="SelectedBar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TvPrimaryButton" TargetType="Button">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Padding" Value="30,0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FF06161D" />
        <Setter Property="Background" Value="{StaticResource TvAccentBrush}" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                        <Border x:Name="Ring" Margin="-5" CornerRadius="13" BorderThickness="3"
                                BorderBrush="{StaticResource TvAccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TvSecondaryButton" TargetType="Button">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Padding" Value="26,0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource TvTextBrush}" />
        <Setter Property="Background" Value="{StaticResource TvSurfaceAltBrush}" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{StaticResource TvBorderBrush}" BorderThickness="1" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                        <Border x:Name="Ring" Margin="-5" CornerRadius="13" BorderThickness="3"
                                BorderBrush="{StaticResource TvAccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TvChipButton" TargetType="Button">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource TvTextSecondaryBrush}" />
        <Setter Property="Background" Value="{StaticResource TvSurfaceAltBrush}" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="23"
                                BorderBrush="{StaticResource TvBorderBrush}" BorderThickness="1" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                        <Border x:Name="Ring" Margin="-4" CornerRadius="27" BorderThickness="3"
                                BorderBrush="{StaticResource TvAccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource TvAccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TvAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource TvTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Poster / wide still card. Implicit style: created by screens via TvTheme.Style(this, "TvPosterCardStyle"). -->
    <Style x:Key="TvPosterCardStyle" TargetType="{x:Type tv:TvPosterCard}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tv:TvPosterCard}">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <StackPanel>
                            <Border Width="{TemplateBinding PosterWidth}" Height="{TemplateBinding PosterHeight}"
                                    CornerRadius="9" Background="{StaticResource TvSurfaceAltBrush}" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{TemplateBinding PosterSource}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border x:Name="Badge" Background="#CC0B0B0D" CornerRadius="6" Padding="8,3"
                                            VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                                        <TextBlock Text="{TemplateBinding BadgeText}" FontSize="14"
                                                   Foreground="{StaticResource TvTextBrush}" />
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Background="#AA0B0B0D" Padding="0,3">
                                        <ProgressBar x:Name="Progress" Style="{StaticResource TvProgressBar}"
                                                     Height="4" Maximum="100" Value="{TemplateBinding ProgressPercent}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="Title" Text="{TemplateBinding TitleText}" FontSize="19"
                                       FontWeight="SemiBold" Foreground="{StaticResource TvTextBrush}"
                                       Margin="1,10,1,0" TextTrimming="CharacterEllipsis"
                                       MaxHeight="46" TextWrapping="Wrap" />
                            <TextBlock Text="{TemplateBinding SubtitleText}" FontSize="14" Margin="1,4,1,0"
                                       Foreground="{StaticResource TvTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border x:Name="Ring" Margin="-6" CornerRadius="13" BorderThickness="3"
                                BorderBrush="{StaticResource TvAccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="tv:TvPosterCard.ShowProgress" Value="False">
                            <Setter TargetName="Progress" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="tv:TvPosterCard.BadgeText" Value="">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TvTextCardStyle" TargetType="{x:Type tv:TvTextCard}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tv:TvTextCard}">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border Width="{TemplateBinding CardWidth}" Height="{TemplateBinding CardHeight}"
                                CornerRadius="10" Background="{StaticResource TvSurfaceBrush}"
                                BorderBrush="{StaticResource TvBorderBrush}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" Margin="24,0">
                                <TextBlock Text="{TemplateBinding AccentText}" FontSize="15"
                                           Foreground="{StaticResource TvAccentBrush}" />
                                <TextBlock Text="{TemplateBinding TitleText}" FontSize="25" FontWeight="SemiBold"
                                           Foreground="{StaticResource TvTextBrush}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{TemplateBinding SubtitleText}" FontSize="15" Margin="0,6,0,0"
                                           Foreground="{StaticResource TvTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="Ring" Margin="-6" CornerRadius="14" BorderThickness="3"
                                BorderBrush="{StaticResource TvAccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TvEpisodeCardStyle" TargetType="{x:Type tv:TvEpisodeCard}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tv:TvEpisodeCard}">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border Width="250" Height="126" CornerRadius="9" Background="{StaticResource TvSurfaceBrush}"
                                BorderBrush="{StaticResource TvBorderBrush}" BorderThickness="1">
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Number" Text="{TemplateBinding NumberText}" FontSize="27"
                                           FontWeight="SemiBold" VerticalAlignment="Top"
                                           Foreground="{StaticResource TvTextBrush}" MinWidth="46" />
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{TemplateBinding TitleText}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource TvTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{TemplateBinding SubtitleText}" FontSize="14" Margin="0,4,0,0"
                                               Foreground="{StaticResource TvTextMutedBrush}" />
                                    <ProgressBar x:Name="Progress" Style="{StaticResource TvProgressBar}" Height="4"
                                                 Margin="0,10,0,0" Maximum="100" Value="{TemplateBinding ProgressPercent}" />
                                </StackPanel>
                                <TextBlock x:Name="Watched" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Foreground="{StaticResource TvAccentBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="Ring" Margin="-6" CornerRadius="13" BorderThickness="3"
                                BorderBrush="{StaticResource TvAccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.13" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.13" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="tv:TvEpisodeCard.ShowProgress" Value="False">
                            <Setter TargetName="Progress" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="tv:TvEpisodeCard.IsWatched" Value="True">
                            <Setter TargetName="Watched" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="tv:TvEpisodeCard.IsCurrent" Value="True">
                            <Setter TargetName="Number" Property="Foreground" Value="{StaticResource TvAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TvKeyButton" TargetType="Button">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Width" Value="62" />
        <Setter Property="Height" Value="58" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource TvTextBrush}" />
        <Setter Property="Background" Value="{StaticResource TvSurfaceAltBrush}" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderBrush="{StaticResource TvBorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TvAccentSoftBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TvAccentBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TvScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="PanningMode" Value="Both" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="TvVerticalScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Settings / info row: full-width content with focus ring. -->
    <Style x:Key="TvRowButton" TargetType="Button">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Height" Value="62" />
        <Setter Property="Cursor" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Root" Background="{StaticResource TvSurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource TvBorderBrush}" BorderThickness="1">
                            <ContentPresenter Margin="24,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <Border x:Name="Ring" Margin="-4" CornerRadius="11" BorderThickness="3"
                                BorderBrush="{StaticResource TvAccentBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TvSurfaceHoverBrush}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>