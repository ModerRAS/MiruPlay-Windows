<UserControl x:Class="MiruPlay.Windows.Controls.SeriesDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource DarkBackground}"
             Foreground="{StaticResource TextPrimary}"
             SizeChanged="DetailRoot_SizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Margin="24,18,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="CompactHeaderRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Style="{StaticResource IconButton}"
                    ToolTip="返回媒体库"
                    AutomationProperties.Name="返回媒体库"
                    Click="Back_Click">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="系列详情" Style="{StaticResource SecondaryText}" FontSize="12" />
                <TextBlock Text="{Binding Series.Title}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Button x:Name="PrimaryActionButton"
                        Style="{StaticResource PrimaryButton}"
                        Padding="18,9"
                        AutomationProperties.Name="{Binding PrimaryAction.AccessibleName}"
                        Click="PrimaryAction_Click"
                        Visibility="Collapsed" />
                <Button x:Name="EditMetadataButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="编辑元数据"
                        Margin="0,8,0,0"
                        AutomationProperties.Name="编辑本地目录元数据"
                        Click="EditMetadata_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="DetailScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,0,24,28">
            <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
                <Grid x:Name="HeroGrid" Margin="0,0,0,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PosterColumn" Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PosterBorder"
                            Width="200"
                            Height="286"
                            Background="{StaticResource AccentBlue}"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Series.Initial}"
                                       FontSize="64"
                                       FontWeight="Bold"
                                       Foreground="#55FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding Series.PosterPath, Converter={StaticResource PosterImageConverter}}"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="DetailCopy" Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Series.Title}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Series.OriginalTitle}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Series.MetadataLine}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Series.CompletionText}" Foreground="{StaticResource ProgressGreen}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Series.Summary}"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"
                                   LineHeight="21"
                                   MaxWidth="720"
                                   Margin="0,16,0,0" />
                        <ItemsControl ItemsSource="{Binding Series.ExternalLinks}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Tag="{Binding Link}"
                                            Content="{Binding DisplayLabel}"
                                            Click="Metadata_Click"
                                            Margin="0,0,8,8"
                                            Padding="10,6"
                                            AutomationProperties.Name="{Binding DisplayLabel}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SeasonHeader" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="剧集" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    <ListBox x:Name="SeasonSelector"
                             Grid.Column="1"
                             Margin="18,0,0,0"
                             ItemsSource="{Binding Seasons}"
                             SelectionChanged="SeasonSelector_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             AutomationProperties.Name="选择季度">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="Padding" Value="12,7" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SeasonBorder" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SeasonBorder" Property="BorderBrush" Value="{StaticResource AnimeRed}" />
                                                    <Setter TargetName="SeasonBorder" Property="Background" Value="{StaticResource ControlPressed}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="SeasonBorder" Property="BorderBrush" Value="{StaticResource TextPrimary}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <TextBlock x:Name="DetailEmptyState"
                           Text="{Binding EmptyStateText}"
                           Style="{StaticResource SecondaryText}"
                           Padding="0,24"
                           Visibility="Collapsed" />

                <ListView x:Name="EpisodeList"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          AutomationProperties.Name="剧集列表">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" CornerRadius="6" Padding="14,11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayNumber}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource SecondaryText}" Margin="0,3,12,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButton}"
                                                Tag="{Binding DefaultVersion.Episode}"
                                                Content="播放"
                                                Click="Episode_Click"
                                                Padding="13,7"
                                                AutomationProperties.Name="{Binding AccessibleName}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Versions}"
                                                  Margin="0,10,0,0"
                                                  Visibility="{Binding HasMultipleVersions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Tag="{Binding Episode}"
                                                        Click="Episode_Click"
                                                        Margin="0,0,8,6"
                                                        Padding="10,6"
                                                        MaxWidth="360"
                                                        AutomationProperties.Name="{Binding AccessibleName}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="ExtrasSection" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock Text="特典" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <ListView x:Name="ExtrasList" Background="Transparent" BorderThickness="0" AutomationProperties.Name="特典列表">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MediaCardButton}"
                                        Tag="{Binding Extra}"
                                        Click="Extra_Click"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="14,10"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Extra.DurationText}" Style="{StaticResource SecondaryText}" Margin="14,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
