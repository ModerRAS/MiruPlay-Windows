<Window x:Class="MiruPlay.Windows.WebDavSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:MiruPlay.Windows.Services"
        Title="{services:Loc wpf.src.davTitle}"
        Width="560"
        Height="500"
        Icon="Assets/MiruPlay.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{services:Loc wpf.src.localTitle}" Style="{StaticResource PageTitle}" FontSize="28" />
        <TextBlock Grid.Row="1" Text="{services:Loc cloud.rssName}" Style="{StaticResource SecondaryText}" Margin="0,20,0,6" />
        <TextBox x:Name="SourceNameBox" Grid.Row="2" Text="WebDAV" />
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{services:Loc sources.username}" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                <TextBox x:Name="UsernameBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{services:Loc sources.password}" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordValueBox" Padding="10,8" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{services:Loc wpf.src.davRoot}" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
            <TextBox x:Name="LocationBox" ToolTip="{services:Loc wpf.src.davTip}" />
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock Text="{services:Loc sources.recognition}" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
            <ComboBox x:Name="RecognitionModeBox" AutomationProperties.Name="{services:Loc wpf.src.davRecogName}">
                <ComboBoxItem Tag="MLIP"><TextBlock Text="MLIP library.db" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                <ComboBoxItem Tag="DIRECTORY"><TextBlock Text="{services:Loc sources.directory}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <TextBlock Grid.Row="6" Text="{services:Loc wpf.src.davNote}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,18,0,0" />
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.cancel}" IsCancel="True" />
            <Button Content="{services:Loc wpf.connectSave}" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
