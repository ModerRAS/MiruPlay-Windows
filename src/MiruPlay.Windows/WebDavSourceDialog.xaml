<Window x:Class="MiruPlay.Windows.WebDavSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加 WebDAV MLIP"
        Width="560"
        Height="430"
        Icon="Assets/MiruPlay.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="WebDAV MLIP" Style="{StaticResource PageTitle}" FontSize="28" />
        <TextBlock Grid.Row="1" Text="名称" Style="{StaticResource SecondaryText}" Margin="0,20,0,6" />
        <TextBox x:Name="SourceNameBox" Grid.Row="2" Text="WebDAV" />
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="用户名" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                <TextBox x:Name="UsernameBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="密码" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordValueBox" Padding="10,8" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="根地址" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
            <TextBox x:Name="LocationBox" ToolTip="支持 HTTP 和 HTTPS；请输入包含 library.db 的 WebDAV 目录" />
        </StackPanel>
        <TextBlock Grid.Row="5" Text="支持 HTTP 和 HTTPS。HTTP 凭据会以明文传输，请仅在可信网络使用。保存前会只读验证 library.db。" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,18,0,0" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="取消" IsCancel="True" />
            <Button Content="连接并保存" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
