<Window x:Class="MiruPlay.Windows.LocalSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:MiruPlay.Windows.Services"
        Title="{services:Loc wpf.src.addLocalTitle}"
        Width="560"
        Height="420"
        Icon="Assets/MiruPlay.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBackground}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{services:Loc wpf.src.localTitle}" Style="{StaticResource PageTitle}" FontSize="28" />
        <TextBlock Grid.Row="1" Text="{services:Loc cloud.rssName}" Style="{StaticResource SecondaryText}" Margin="0,20,0,6" />
        <TextBox x:Name="SourceNameBox" Grid.Row="2" Text="{services:Loc wpf.src.localMedia}" />
        <TextBlock Grid.Row="3" Text="{services:Loc wpf.src.rootDir}" Style="{StaticResource SecondaryText}" Margin="0,16,0,6" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LocationBox" ToolTip="{services:Loc wpf.src.browseTip}" />
            <Button Grid.Column="1" Content="{services:Loc wpf.browse}" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>
        <StackPanel Grid.Row="5" Margin="0,18,0,0">
            <TextBlock Text="{services:Loc sources.recognition}" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
            <ComboBox x:Name="RecognitionModeBox" AutomationProperties.Name="{services:Loc wpf.src.localRecogName}">
                <ComboBoxItem Tag="MLIP"><TextBlock Text="MLIP library.db" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
                <ComboBoxItem Tag="DIRECTORY"><TextBlock Text="{services:Loc sources.directory}" Style="{StaticResource ComboItemText}" /></ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{services:Loc wpf.cancel}" IsCancel="True" />
            <Button Content="{services:Loc wpf.connectSave}" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
